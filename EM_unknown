# runs EM algorithm for unknown pi
def em_closed_unknown(x, a, init1, init2, eps, its):
    diff = 100
    current = [init1,init2]
    n = len(x)
    j=0
    iterates = []
    for k in range(its):
        sum_beta = 0
        sum_pi = 0
        T = np.zeros(shape=n)
        for i in range(n):
            T[i] = ( current[1] * math.exp(-x[i]/current[0]) ) / (current[1] * math.exp(-x[i]/current[0]) + (1-current[1]) * a * math.exp(-a*x[i]/current[0]) )
            sum_pi += T[i]
            sum_beta += a * x[i] - x[i] * (a-1) * T[i]
        pi = (1/n)* sum_pi
        beta = (1/n)* sum_beta
        # diff = [abs(new-current)]
        current = [beta, pi]
        iterates.append(current[0])
    j = its
    return current,j,iterates

# runs simulations for unknown pi
def run_sims_unknown(beta, a, pi, n, eps, runs, it, sample):
    em_df = pd.DataFrame(columns=['beta', 'pi', 'a','n','em_est_beta','em_est_pi','iter','error','final_error_beta', 'final_error_pi'])
    index=0
    for i in beta:
        for j in a:
            for k in n:
                for N in range(runs):
                    np.random.seed(100+N)
                    x = draw_sample(i, j, k, pi)
                    # init = (1 + 1/a) / (2*np.mean(x)) + np.random.normal(0.1,0.1)
                    init1 = np.random.uniform(0,sample)
                    init2 = np.random.uniform(0,1)
                    em_est, iters,iterates = em_closed_unknown(x,j,init1,init2,eps, it)
                    f_error_b = abs(i-em_est[0])
                    f_error_p = abs(pi-em_est[1])
                    for iter in range(iters):
                        error = abs(iterates[iter]-i)
                        new_row = [i,pi,j,k,em_est[0],em_est[1],iter+1,error, f_error_b, f_error_p]
                        em_df.loc[index] = new_row
                        index+=1
    em_df['final_error_beta'] = abs(em_df['beta']-em_df['em_est_beta'])
    em_df['final_error_pi'] = abs(em_df['pi']-em_df['em_est_pi'])
    em_df = em_df.groupby(['beta','pi', 'a', 'n','iter']).mean().reset_index()
    return em_df

# runs simulations for noisy alpha
def run_sims_noise(beta, a, n, eps, runs, it, sample):
    em_df = pd.DataFrame(columns=['beta', 'a','n','em_est','iter','error', 'ratio'])
    index=0
    for i in beta:
        for j in a:
            for k in n:
                for N in range(runs):
                    r = j / i
                    np.random.seed(100+N)
                    x = draw_sample(i, j, k, 0.5)
                    # init = (1 + 1/a) / (2*np.mean(x)) + np.random.normal(0.1,0.1)
                    init = np.random.uniform(0,sample)
                    # SNR = 4
                    noise = np.random.normal(0,0.25 * j)
                    # add noise here to alpha estimate passed to EM algorithm
                    em_est, iters,iterates = em_closed(x,j + noise,init,eps, it)
                    for iter in range(iters):
                        error = abs(iterates[iter]-i)
                        new_row = [i,j,k,em_est,iter+1,error, r]
                        em_df.loc[index] = new_row
                        index+=1
    em_df['final_error'] = abs(em_df['beta']-em_df['em_est'])
    em_df = em_df.groupby(['beta', 'a', 'n','iter']).mean().reset_index()
    return em_df

