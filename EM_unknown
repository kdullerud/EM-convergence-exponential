# function to draw exponential mixture, returns shuffled sample
def draw_sample(beta, a, n, pi):
    n_1 = np.sum(np.random.binomial(n,pi))
    x_1 = np.random.exponential(beta,n_1)
    x_2 = np.random.exponential(beta / a, n-n_1)
    x = np.concat((x_1,x_2))
    np.random.shuffle(x)
    return x

# function to derive error bound found in Corollary 5
def bound(row, delta=0.05,eps=0.01):
    value = (row['beta'] ) * (math.sqrt(math.log(2/delta)/row['n']) + math.log(2/delta)/row['n']) + eps
    return value

