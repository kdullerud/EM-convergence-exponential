# E step calculation
def e_step(beta, x, a,beta_t):
    n = len(x)
    p_z = np.sum( [ x_i*(1 / (1 + a * np.exp((1-a)*x_i/beta_t))) for x_i in x] )
    q_t = -n * np.log(beta) - a / beta * np.sum(x) + (a-1) / beta *p_z
    return (-1)*q_t

# algorithm using E function above and optimizer
def em_classic(x,a,init,eps):
    beta_t = init
    diff = 100
    while diff > eps: 
        res_M = minimize(e_step, x0=beta_t, args=(x, a, beta_t),
                    method='Nelder-Mead', bounds=[(0.0001,500)])
        new = res_M.x[0]
        diff = abs(new - beta_t)
        beta_t = new
    return beta_t

def bound(row, delta=0.05,eps=0.01):
    value = (row['beta'] ) * (math.sqrt(math.log(2/delta)/row['n']) + math.log(2/delta)/row['n']) + eps
    return value

def run_sims(beta, a, n, eps, runs, it, sample):
    em_df = pd.DataFrame(columns=['beta', 'a','n','em_est','iter','error', 'ratio'])
    index=0
    for i in beta:
        for j in a:
            for k in n:
                for N in range(runs):
                    r = j / i
                    np.random.seed(100+N)
                    x = draw_sample(i, j, k, 0.5)
                    # init = (1 + 1/a) / (2*np.mean(x)) + np.random.normal(0.1,0.1)
                    init = np.random.uniform(0,sample)
                    em_est, iters,iterates = em_closed(x,j,init,eps, it)
                    for iter in range(iters):
                        error = abs(iterates[iter]-i)
                        new_row = [i,j,k,em_est,iter+1,error, r]
                        em_df.loc[index] = new_row
                        index+=1
    em_df['final_error'] = abs(em_df['beta']-em_df['em_est'])
    em_df = em_df.groupby(['beta', 'a', 'n','iter']).mean().reset_index()
    return em_df


def run_plot_1(em_df, N, alpha):
    df_plot1 = em_df[(em_df['n']== N ) & (em_df['a']== alpha )]
    fig, ax = plt.subplots()
    sns.set_theme(font='Arial')
    sns.set_style("white")

    ax = sns.lineplot(data=df_plot1, x='iter',y='error',hue=df_plot1[['a', 'beta']].apply(tuple, axis=1), 
             marker='o', errorbar=None)
    plt.legend(loc=(0.95, 0.5), title = ('(α,β)'))
    ax.set_yscale("log")
    ax.set_xlabel('Iteration #')
    ax.set_ylabel('Abs. Error')
    plt.title('Statistical Error vs. Iteration')
    plt.show()

def run_plot_2(em_df):
    df_plot2 = em_df
    df_plot2['bound'] = df_plot2.apply(bound, axis=1)
    sns.set_theme(font='Arial')
    sns.set_style("white")

    fig, ax = plt.subplots()
    sns.lineplot(data=df_plot2, x='n',y='final_error',hue=df_plot2[['a', 'beta']].apply(tuple, axis=1), 
                marker='o', errorbar=None, ax=ax)
    sns.lineplot(data=df_plot2, x='n',y='bound',hue=df_plot2[['a', 'beta']].apply(tuple, axis=1), 
                linestyle='dotted', errorbar=None, ax=ax)
    plt.legend(loc=(0.85, 0.7), title = ('(α,β)'))
    ax.set_yscale("log")
    ax.set_xscale("log")
    ax.set_xticks(em_df['n'].unique().tolist(), labels=em_df['n'].unique().tolist())
    ax.set_ylabel('Abs. Error')
    plt.title('Final Estimate Error vs. Sample Size')
    plt.show()


