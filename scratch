def expect_lamb(x,lamb,a):
    return x*(1 + a*np.exp((1-a)*lamb*x))**(-1)

# conditional probability of z for additive case:
def pz_add(x,lamb,a):
    return ( 1 + (1 + (a/lamb) ) * np.exp(-a*x) )**(-1)

